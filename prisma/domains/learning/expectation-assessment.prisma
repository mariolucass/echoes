enum ExpectationAssessmentResult {
  MET
  PARTIALLY_MET
  NOT_MET
  INCONCLUSIVE
}

model ExpectationAssessment {
  id            String                      @id @default(uuid()) @db.Uuid
  decisionId    String                      @db.Uuid
  expectationId String                      @db.Uuid
  outcomeId     String                      @db.Uuid
  result        ExpectationAssessmentResult
  notes         String?
  createdAt     DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                    @updatedAt @db.Timestamptz(3)

  expectation Expectation @relation(fields: [expectationId, decisionId], references: [id, decisionId], onDelete: Cascade)
  outcome     Outcome     @relation(fields: [outcomeId, decisionId], references: [id, decisionId], onDelete: Cascade)

  @@unique([expectationId, outcomeId])
  @@index([outcomeId, decisionId])
}
