enum DecisionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ABANDONED
  ARCHIVED
}

model Decision {
  id          String         @id @default(uuid()) @db.Uuid
  title       String         @db.VarChar(200)
  description String?
  context     String?
  status      DecisionStatus @default(DRAFT)
  decidedAt   DateTime?
  rationale   String?
  chosenAlternativeId String? @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?      @db.Timestamptz(3)
  userId      String         @db.Uuid

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  expectations Expectation[]
  alternatives DecisionAlternative[] @relation("DecisionAlternatives")
  chosenAlternative DecisionAlternative? @relation("ChosenAlternative", fields: [chosenAlternativeId, id], references: [id, decisionId], onDelete: Restrict)
  revisions DecisionRevision[]
  checkpoints  Checkpoint[]
  outcomes     Outcome[]
  reflections  Reflection[]
  metrics      Metric[]
  tags         DecisionTag[]

  @@unique([id, userId])
  @@index([userId, deletedAt, createdAt, id])
  @@index([userId, deletedAt, status, createdAt, id])
  @@index([userId, deletedAt, decidedAt, id])
}
