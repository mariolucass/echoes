{
  "name": "echoes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/ensure-prisma-client.mjs && tsx watch src/server.ts",
    "build": "node scripts/ensure-prisma-client.mjs && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "node scripts/ensure-prisma-client.mjs && vitest run --project unit --project api",
    "test:unit": "node scripts/ensure-prisma-client.mjs && vitest run --project unit",
    "test:api": "node scripts/ensure-prisma-client.mjs && vitest run --project api",
    "test:integration": "node scripts/run-db-tests.mjs integration",
    "test:e2e": "node scripts/run-db-tests.mjs e2e",
    "test:db": "node scripts/run-db-tests.mjs",
    "test:db:up": "docker compose -p echoes-test -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -p echoes-test -f docker-compose.test.yml down",
    "test:typecheck": "node scripts/ensure-prisma-client.mjs && tsc -p tsconfig.test.json",
    "slides": "slidev docs/slide/slides.config.md --port 3030",
    "slides:build": "slidev build docs/slide/slides.config.md --out dist",
    "slides:export": "slidev export docs/slide/slides.config.md --dark --with-clicks --output docs/slide/exports/echoes.pdf",
    "slides:setup": "playwright install chromium",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "node scripts/ensure-prisma-client.mjs --force",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@hono/zod-openapi": "^1.6.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@scalar/hono-api-reference": "^0.12.6",
    "dotenv": "^18.0.4",
    "hono": "^4.13.9",
    "hono-pino": "^0.10.3",
    "jose": "^6.2.12",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@slidev/cli": "^53.0.0",
    "@slidev/types": "^53.0.0",
    "@types/node": "^24.19.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.1.3",
    "playwright-chromium": "^1.63.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "vue": "^3.5.43"
  }
}
