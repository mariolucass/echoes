PORT=3333
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/echoes
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
TRUST_PROXY_HOPS=0
API_TIME_ZONE=America/Sao_Paulo
# Set to true to block API requests on Saturdays and Sundays.
WEEKDAY_ONLY_ENABLED=false
CORS_ALLOWED_ORIGINS=
