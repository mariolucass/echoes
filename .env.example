# =============================================================================
# Echoes API — variáveis de ambiente
# Copie para `.env` e ajuste os valores. Nunca commite o `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
# Porta HTTP em que a API escuta.
PORT=3333

# Ambiente de execução: development | test | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Em produção, use credenciais próprias (nunca as padrão do Postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/echoes

# -----------------------------------------------------------------------------
# Autenticação
# -----------------------------------------------------------------------------
# Segredo usado para assinar os JWTs. Mínimo de 32 bytes, aleatório e único
# por ambiente. Para gerar um:
#   openssl rand -base64 48
JWT_SECRET=

# -----------------------------------------------------------------------------
# Rede / Proxy
# -----------------------------------------------------------------------------
# Quantos proxies confiáveis existem na frente da API (nginx, load balancer...).
# 0 = sem proxy (dev local). Um valor errado faz o IP do cliente ser lido
# incorretamente, o que afeta logs e rate limiting.
TRUST_PROXY_HOPS=0

# Origens permitidas no CORS, separadas por vírgula, sem barra final.
# Exemplo: https://app.exemplo.com,https://admin.exemplo.com
# Vazio = nenhuma origem externa permitida.
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Regras de negócio
# -----------------------------------------------------------------------------
# Fuso horário (IANA) usado para decidir o que é "fim de semana".
API_TIME_ZONE=America/Sao_Paulo

# true = bloqueia requisições aos sábados e domingos (no fuso acima).
# false = a API responde todos os dias.
WEEKDAY_ONLY_ENABLED=false
