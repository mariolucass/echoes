# =============================================================================
# Echoes API — variáveis de ambiente
# Copie para `.env` e ajuste os valores. Nunca commite o `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Servidor
# -----------------------------------------------------------------------------
# Porta HTTP em que a API escuta.
PORT=3333

# Opcional: origem do aplicativo usada nos links dos IDs curtos do PDF.
# APP_BASE_URL=https://app.exemplo.com

# Ambiente de execução: development | test | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO
# Em produção, use credenciais próprias (nunca as padrão do Postgres).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/echoes

# -----------------------------------------------------------------------------
# Autenticação
# -----------------------------------------------------------------------------
# Segredo usado para assinar os JWTs. Mínimo de 32 bytes, aleatório e único
# por ambiente. Para gerar um:
#   openssl rand -base64 48
JWT_SECRET=

# -----------------------------------------------------------------------------
# Rede / Proxy
# -----------------------------------------------------------------------------
# Quantos proxies confiáveis existem na frente da API (nginx, load balancer...).
# 0 = sem proxy (dev local). Um valor errado faz o IP do cliente ser lido
# incorretamente, o que afeta logs e rate limiting.
TRUST_PROXY_HOPS=0

# CORS: por padrão só a própria origem do servidor (http://localhost:PORT) é aceita.
# Origens extras (opcional), separadas por vírgula, sem barra final.
# Exemplo: https://app.exemplo.com
# Vazio = apenas o mesmo servidor.
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Regras de negócio
# -----------------------------------------------------------------------------
# Fuso horário (IANA) usado para decidir o que é "fim de semana".
API_TIME_ZONE=America/Sao_Paulo

# true = bloqueia requisições aos sábados e domingos (no fuso acima).
# false = a API responde todos os dias.
WEEKDAY_ONLY_ENABLED=false

# -----------------------------------------------------------------------------
# Segundo fator (2FA por e-mail)
# -----------------------------------------------------------------------------
# true = o login exige um código de 6 dígitos enviado por e-mail (POST /identity/auth/verify-2fa).
TWO_FACTOR_ENABLED=true
# SMTP para envio do código. Sem SMTP_HOST (apenas fora de produção) o código é
# escrito no log do servidor, útil para desenvolvimento.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Echoes <no-reply@echoes.local>"

# -----------------------------------------------------------------------------
# Upload de imagem (Cloudinary)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=echoes/avatars

# -----------------------------------------------------------------------------
# MongoDB Atlas (usuários)
# -----------------------------------------------------------------------------
# Com MONGODB_URI definida, os usuários são armazenados no MongoDB (fonte de verdade);
# o PostgreSQL mantém apenas um registro espelho (mesmo id) para as chaves estrangeiras.
# Sem ela, tudo continua no PostgreSQL.
# Ex.: mongodb+srv://USUARIO:SENHA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB=echoes
